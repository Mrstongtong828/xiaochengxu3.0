.profile .p-name { font-size: 30rpx; font-weight: 600; }
.profile .p-edit { font-size: 25rpx; color: var(--brand); }

/* 首页卡片与提示条的左右留白 */
.page > .card,
.page > .tip {
  margin-left: var(--gap);
  margin-right: var(--gap);
}
.page > .card:first-child { margin-top: 20rpx; }

.p-nums { display: flex; margin: 18rpx 0 8rpx; }
.p-num { margin-right: 52rpx; }
.p-num .num {
  font-size: 50rpx;
  font-weight: 600;
  color: var(--brand-dark);
  letter-spacing: -1rpx;
}
.p-num .unit { font-size: 24rpx; color: var(--text-3); margin-left: 6rpx; }

.quick { display: flex; }
.quick-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  position: relative;
}
.quick-item + .quick-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: var(--line);
}

.qi {
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 8rpx;
}
.qi-search {
  border: 4rpx solid var(--brand);
  border-radius: 50%;
  box-sizing: border-box;
  width: 34rpx;
  height: 34rpx;
  position: relative;
}
.qi-search::after {
  content: "";
  position: absolute;
  right: -16rpx;
  bottom: -10rpx;
  width: 18rpx;
  height: 4rpx;
  background: var(--brand);
  transform: rotate(45deg);
}
.qi-book {
  width: 34rpx;
  height: 40rpx;
  border: 4rpx solid var(--brand);
  border-radius: 6rpx;
  box-sizing: border-box;
  margin-top: 2rpx;
}
.qi-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  width: 40rpx;
  height: 40rpx;
  border-bottom: 4rpx solid var(--brand);
  box-sizing: border-box;
}
.qi-chart::before {
  content: "";
  width: 8rpx;
  height: 18rpx;
  background: var(--brand);
}
.qi-chart::after {
  content: "";
  width: 8rpx;
  height: 30rpx;
  background: var(--brand);
}

.grade-list { display: flex; margin-top: 18rpx; }
.grade-item {
  flex: 1;
  text-align: center;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 18rpx 6rpx;
  margin-right: 14rpx;
}
.grade-item:last-child { margin-right: 0; }
.g-num {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--brand-dark);
}
.grade-note { margin-top: 16rpx; }
.qa-line { line-height: 1.9; }
.foot-note { padding: 10rpx 4rpx 40rpx; }
