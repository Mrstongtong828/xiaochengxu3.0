.page > .card, .page > .tip { margin: 20rpx var(--gap); }

.field {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line);
}
.field:first-of-type { border-top: 0; }
.field-label { width: 220rpx; font-size: 27rpx; color: var(--text-2); }
.field-input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand-dark);
}
.field-note { margin-top: 12rpx; }

.seg {
  flex: 1;
  display: flex;
  background: #E9EDF2;
  border-radius: 12rpx;
  padding: 6rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 10rpx 0;
  border-radius: 8rpx;
}
.seg-on { background: #fff; color: var(--brand); font-weight: 600; }

.chip-row { display: flex; flex-wrap: wrap; flex: 1; }
.chip-row .chip { margin: 0 16rpx 0 0; }
