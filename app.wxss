@import "./styles/theme.wxss";

page {
  background: var(--page-bg);
  color: var(--text-1);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

.page { padding-bottom: 30rpx; }

/* 通用卡片 */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: var(--gap);
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 44, 71, 0.05);
}

.card-tight {
  padding: 20rpx var(--gap);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
}

/* 行布局 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 18rpx 0;
}

/* 文字层级 */
.t-main { font-size: 30rpx; color: var(--text-1); }
.t-sub  { font-size: 24rpx; color: var(--text-2); }
.t-tiny { font-size: 22rpx; color: var(--text-3); line-height: 1.55; }
.t-num  { font-size: 46rpx; font-weight: 600; color: var(--brand-dark); }
.bold   { font-weight: 600; }

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--gray-bg);
  color: var(--text-2);
}
.tag-ok    { background: var(--ok-bg);    color: var(--ok-text); }
.tag-warn  { background: var(--warn-bg);  color: var(--warn-text); }
.tag-no    { background: var(--danger-bg); color: var(--danger); }
.tag-line  { background: #fff; border: 1rpx solid var(--line); }
.tag-brand { background: var(--brand-light); color: var(--brand); font-weight: 600; }

/* 提示条 */
.tip {
  background: var(--brand-light);
  color: var(--brand-dark);
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}
.tip-warn { background: var(--warn-bg); color: var(--warn-text); }
.tip-no   { background: var(--danger-bg); color: var(--danger); }
.tip-plain{ background: #fff; color: var(--text-2); border: 1rpx solid var(--line); }

/* 结论条 */
.conclusion {
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 20rpx;
}
.conclusion-ok { background: var(--ok-bg); color: var(--ok-text); }
.conclusion-no { background: var(--danger-bg); color: var(--danger); }
.conclusion .c-sub {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-2);
  margin-top: 6rpx;
}

/* 按钮 */
.btn {
  background: var(--brand);
  color: #fff;
  border-radius: var(--radius-btn);
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-ghost {
  background: #fff;
  color: var(--brand);
  border: 1rpx solid var(--brand-mid);
  font-weight: 500;
}
.btn-light { background: var(--brand-light); color: var(--brand); font-weight: 500; }
.btn-disabled { background: #C8D0DA; color: #fff; }
.btn-sm {
  display: inline-block;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

/* 底部固定操作条 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx var(--gap) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-top: 1rpx solid var(--line);
  display: flex;
  gap: 20rpx;
  z-index: 20;
}
.bottom-bar .btn { flex: 1; }
.page-with-bar { padding-bottom: 180rpx; }

/* 筛选标签 */
.chips {
  display: flex;
  flex-wrap: nowrap;
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.chip {
  display: inline-block;
  border: 1rpx solid var(--line);
  background: #fff;
  border-radius: 30rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: var(--text-2);
  margin-right: 16rpx;
}
.chip-on {
  background: var(--brand-light);
  border-color: var(--brand-mid);
  color: var(--brand);
  font-weight: 600;
}

/* 数据行 */
.kv {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx dashed var(--line);
}
.kv:first-child { border-top: 0; }
.kv .k { font-size: 26rpx; color: var(--text-2); }
.kv .v { font-size: 28rpx; font-weight: 600; }
.kv .v .unit { font-size: 22rpx; font-weight: 400; color: var(--text-3); margin-left: 4rpx; }

/* 复选框 */
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 3rpx solid #C8D0DA;
  flex: none;
  margin-top: 6rpx;
  position: relative;
  box-sizing: border-box;
}
.checkbox-on { background: var(--brand); border-color: var(--brand); }
.checkbox-on::after {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 2rpx;
  width: 10rpx;
  height: 18rpx;
  border: 4rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(42deg);
}

/* 开关 */
.switch {
  width: 88rpx;
  height: 50rpx;
  border-radius: 26rpx;
  background: var(--brand);
  position: relative;
  flex: none;
}
.switch::after {
  content: "";
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #fff;
}
.switch-off { background: #CBD3DD; }
.switch-off::after { right: auto; left: 6rpx; }

/* 列表行 */
.item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}
.item:first-child { border-top: 0; }
.item-arrow { color: #C2CAD4; font-size: 30rpx; margin-left: 8rpx; }

/* 序号 */
.ord {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.empty {
  text-align: center;
  padding: 90rpx 40rpx;
  color: var(--text-3);
  font-size: 26rpx;
}
